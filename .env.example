# Copy to .env and fill in. .env holds the bot token: chmod 600, never commit it.

# Token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user ids with access from the start. The first one is the owner:
# access requests from other people go to them («Разрешить» / «Отклонить»), and /users works for them.
# Empty: there is no owner and the bot refuses everyone, replying with their id (that's how you find yours).
ALLOWED_IDS=
# OWNER_ID=               # explicit owner, if not the first of ALLOWED_IDS
# ACCESS_PER_HOUR=3       # new access requests per hour across everyone; extra ones are silently ignored

# Solarman data logger of the Deye inverter on your LAN. Read-only: the bot never writes registers.
# LOGGER_HOST: the logger's IP, e.g. 192.168.1.50. LOGGER_SERIAL: its serial number (sticker on the logger).
LOGGER_HOST=
LOGGER_SERIAL=
# LOGGER_PORT=8899
# LOGGER_SLAVE=1

# YASNO outage group (черга), e.g. 3.1. Defaults are for Kyiv.
GROUP=
# YASNO_REGION=25
# YASNO_DSO=902

# Which dashboard widget to send: a («Табло», current) or b (older layout)
WIDGET=a
# WIDGET_PATH=            # explicit HTML path instead of widgets/<WIDGET>.html
# WIDGET_WIDTH=0          # size hints for sendWidget, 0 = auto
# WIDGET_HEIGHT=0
# WIDGET_QUERIES=0        # 1 = sendWidget with allow_queries

# «Инвертор» widget (the Inverter button)
# INVERTER_PATH=          # HTML, default widgets/inverter.html
# INVERTER_MINUTES=15     # how long the bot keeps updating it after a tap (then it shows «Снимок на HH:MM»)
# INVERTER_INTERVAL=30    # edits no more often than this, s
# WIDGET_PROBE_MINUTES=30 # text mode: how often to check whether Telegram allows widgets again

# Rated battery energy, kWh (Ah × nominal voltage), e.g. 280 Ah × 51.2 V = 14.34.
# Empty: no "battery lasts until" forecast.
BATTERY_KWH=

# Tuning (defaults shown)
# GRID_ON_V=170           # grid voltage threshold for "power is on", V
# POLL_INTERVAL=10        # inverter poll, s
# SCHEDULE_INTERVAL=300   # schedule poll, s
# LIVE_INTERVAL=60        # dashboard edits on change, no more often than, s
# FRESH_INTERVAL=120      # ...and no less often than (while the inverter answers), s
# DASHBOARD_RENEW_HOURS=47  # silently re-send a dashboard older than this (deleteMessage works up to 48 h); 0 = never
# DATA_DIR=data           # where the sqlite database lives
# TZ_NAME=Europe/Kyiv
# LOG_LEVEL=INFO
# API_BASE=https://api.telegram.org
# API_TEST=0              # 1 = Telegram test server (test bot token)
